# Gemini Live (STT + conversational LLM + TTS)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# JEV (TypeSafe AI) - language-switch decision engine
# Note: the real @typesafe-ai/sdk client reads TYPESAFE_API_KEY automatically,
# not JEV_API_KEY, so that's the variable name that must be set here.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=1600

# How long (ms) to hold back a fresh reply's audio while waiting on JEV's
# decision, so a switch never plays the old language at all instead of
# playing-then-cutting it. Must be >= JEV_TIMEOUT_MS, otherwise a decision
# that's still legitimately in flight can arrive after the hold already gave
# up and released old-language audio - see AUDIO_HOLD_MS in languageConfig.ts.
# This is a ceiling, not a fixed delay: fast decisions release as soon as
# they resolve, so raising this doesn't slow down the common case.
AUDIO_HOLD_MS=1750

# How long (ms), right after sending an interrupting language switch, to
# drop incoming audio chunks outright instead of forwarding them - swallows
# the brief garbled/wrong-language blip that can arrive while Gemini's
# backend is still catching up to the interrupt. See POST_SWITCH_SQUELCH_MS
# in languageConfig.ts.
POST_SWITCH_SQUELCH_MS=220

PORT=3001

# Optional: only needed if the client dev server runs somewhere other than localhost
VITE_WS_URL=ws://localhost:3001
